{
    "name": "bastien-jcln/swiss-cooking",
    "description": "To Do",
    "type": "project",
    "require": {
        "slim/slim": "4.*",
        "slim/psr7": "^1.7",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "guzzlehttp/psr7": "^2",
        "laminas/laminas-diactoros": "^3.6",
        "slim/php-view": "^3.4",
        "fakerphp/faker": "^1.24"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "BastienJcln\\SwissCooking\\": "src/"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "bastien-jcln",
            "email": "bastien.jcln@eduge.ch"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "pestphp/pest": "^5.2"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
